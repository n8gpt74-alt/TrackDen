POSTGRES_DB=finance_tracker
POSTGRES_USER=finance_user
POSTGRES_PASSWORD=finance_password
POSTGRES_PORT=5432

REDIS_PORT=6379

BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
BACKEND_ENV=development
BACKEND_DEBUG=true
BACKEND_CORS_ORIGINS=http://localhost:5173
BACKEND_SECRET_KEY=change-me
BACKEND_DATABASE_URL=postgresql+asyncpg://finance_user:finance_password@postgres:5432/finance_tracker
BACKEND_SYNC_DATABASE_URL=postgresql+psycopg://finance_user:finance_password@postgres:5432/finance_tracker
# Optional on serverless deploys when inline OCR fallback is enough
BACKEND_REDIS_URL=redis://redis:6379/0
BACKEND_TELEGRAM_BOT_TOKEN=replace-with-bot-token
BACKEND_ALLOWED_CLOCK_SKEW_SECONDS=300
BACKEND_UPLOAD_DIR=/app/uploads
# For Vercel serverless backend prefer /tmp/trackden-uploads
BACKEND_OCR_PROVIDER=mock
BACKEND_AI_PROVIDER=mock
BACKEND_LOG_LEVEL=INFO
BACKEND_DEV_AUTH_ENABLED=true
BACKEND_DEV_AUTH_USER_ID=777000
BACKEND_DEV_AUTH_USERNAME=local_dev
BACKEND_DEV_AUTH_FIRST_NAME=Local
BACKEND_DEV_AUTH_LAST_NAME=Developer

FRONTEND_PORT=5173
VITE_DATA_MODE=local
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Example for Vercel frontend: https://your-api-project.vercel.app/api/v1

BOT_ENV=development
BOT_LOG_LEVEL=INFO
BOT_TOKEN=replace-with-bot-token
BOT_WEBAPP_URL=http://localhost:5173
